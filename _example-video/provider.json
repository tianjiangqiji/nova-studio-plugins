{
  "apiVersion": 1,
  "submit": {
    "method": "POST",
    "url": "{{baseUrl}}/v1/video/generate",
    "timeoutMs": 60000,
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer {{apiKey}}"
    },
    "body": {
      "model": "{{model}}",
      "prompt": "{{fields.prompt}}",
      "duration": "{{fields.seconds}}",
      "resolution": "{{facet.resolution}}",
      "image_urls": "{{media.refImage}}"
    },
    "extract": {
      "taskId": ["id", "task_id", "data.id"]
    },
    "error": {
      "from": ["error.message", "error", "message", "detail"]
    }
  },
  "poll": {
    "method": "GET",
    "url": "{{baseUrl}}/v1/video/tasks/{{upstreamTaskId}}",
    "timeoutMs": 15000,
    "intervalMs": 10000,
    "maxTotalMs": 900000,
    "headers": {
      "Authorization": "Bearer {{apiKey}}"
    },
    "status": {
      "from": ["status", "state"],
      "completed": ["completed", "succeeded", "success"],
      "failed": ["failed", "error"],
      "queued": ["queued", "pending", "waiting"],
      "processing": ["processing", "running", "in_progress"]
    },
    "progress": {
      "from": ["progress", "percent"],
      "scale": "0-100"
    },
    "result": {
      "assets": [
        {
          "kind": "video",
          "mime": "video/mp4",
          "url": ["video_url", "url", "output.url", "result.url", "data.0.url"],
          "posterUrl": ["cover_url", "thumbnail_url"],
          "durationSec": ["duration", "seconds"]
        }
      ]
    },
    "error": {
      "from": ["error.message", "error", "message", "detail"]
    },
    "fatalHttpStatus": [400, 401, 403]
  }
}
